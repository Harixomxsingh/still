op-filter:blur(20px);color:#fff;font-size:14px;font-weight:600;letter-spacing:.02em;display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:0 28px;box-shadow:0 10px 30px #00000080,inset 0 1px #ffffff59;cursor:pointer;transition:all .25s cubic-bezier(.16,1,.3,1)}.home-cta-button:hover{background:#ffffff24;border-color:#ffffff59;transform:translateY(-1px) scale(1.03);box-shadow:0 15px 40px #0009,inset 0 1px #ffffff80}.sos-rescue-card{background:#0c111da6;border:1px solid rgba(255,255,255,.08);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);box-shadow:0 8px 24px #0006;border-radius:18px;padding:12px 14px;display:flex;flex-direction:column;align-items:flex-start;text-align:left;gap:4px;cursor:pointer;transition:all .25s cubic-bezier(.16,1,.3,1);position:relative}.sos-rescue-card:hover{background:#ffffff14;border-color:#ffffff38;transform:translateY(-2px);box-shadow:0 12px 32px #0009}.track-science-pill{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:500;color:var(--accent-primary);font-family:JetBrains Mono,monospace;background:#ffffff08;border:1px solid var(--card-border);padding:4px 12px;border-radius:9999px}.track-desc{font-size:12.5px;font-weight:300;line-height:1.55;color:var(--text-secondary)}.habit-progress-container{width:100%;max-width:330px;margin-top:6px;display:flex;flex-direction:column;gap:6px;cursor:pointer;padding:8px 12px;border-radius:16px;background:#0e14228c;border:1px solid rgba(255,255,255,.08);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);box-shadow:0 4px 20px #00000059;transition:all .25s cubic-bezier(.16,1,.3,1)}.habit-progress-container:hover{background:#ffffff0f;border-color:#38bdf84d;transform:translateY(-1px)}.habit-progress-meta{display:flex;align-items:center;justify-content:space-between;width:100%}.habit-meta-label{display:inline-flex;align-items:center;gap:5px;font-size:11px;font-weight:600;color:#f1f5f9;letter-spacing:-.01em}.habit-meta-percent{font-family:JetBrains Mono,monospace;font-weight:700;font-size:10.5px;color:#38bdf8}.habit-progress-track{position:relative;width:100%;height:5px;border-radius:9999px;background:#ffffff14;overflow:visible}.habit-progress-fill{position:absolute;top:0;left:0;height:100%;border-radius:9999px;background:linear-gradient(90deg,#38bdf8,#818cf8 60%,#f59e0b);box-shadow:0 0 10px #38bdf880;transition:width .4s ease}.habit-progress-head{position:absolute;top:50%;transform:translate(-50%,-50%);width:11px;height:11px;border-radius:50%;background:#fff;border:2px solid #38bdf8;box-shadow:0 0 8px #38bdf8e6;transition:left .4s ease;pointer-events:none}.monolith-console{width:100%;background:var(--console-bg);border:1px solid var(--card-border);border-radius:26px;padding:16px 20px;backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);box-shadow:0 20px 50px #0009,inset 0 1px #ffffff0d;display:flex;flex-direction:column;gap:14px;transition:opacity .8s cubic-bezier(.16,1,.3,1),transform .8s cubic-bezier(.16,1,.3,1)}.playback-row{display:flex;align-items:center;justify-content:center;gap:24px}.master-play-button{width:58px;height:58px;border-radius:50%;background:linear-gradient(135deg,#fff,#d4d4d8);color:#09090b;display:flex;align-items:center;justify-content:center;cursor:pointer;border:none;box-shadow:0 0 25px #ffffff59;transition:all .2s cubic-bezier(.16,1,.3,1)}.master-play-button:hover{transform:scale(1.08);box-shadow:0 0 35px #fff9}.icon-action-btn{width:32px;height:32px;border-radius:50%;background:#ffffff0a;border:1px solid var(--card-border);color:var(--text-primary);display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;transition:all .2s ease}.icon-action-btn:hover{background:#ffffff1a;border-color:var(--accent-primary);color:#fff;transform:scale(1.06)}.volume-container{display:flex;align-items:center;gap:12px;padding:0 4px}.volume-container input[type=range]{-webkit-appearance:none;-moz-appearance:none;appearance:none;flex:1;height:4px;background:#ffff