.04) 42%, transparent 80%);--accent-primary: #34d399;--accent-secondary: #10b981;--accent-glow: rgba(52, 211, 153, .35);--card-bg: rgba(255, 255, 255, .03);--card-border: rgba(52, 211, 153, .14);--text-primary: #ecfdf5;--text-secondary: #6ee7b7;--text-muted: #4b5563;--console-bg: rgba(7, 20, 13, .88)}[data-theme=lavender]{--bg-color: #080410;--bg-gradient: radial-gradient(circle at 50% 40%, rgba(192, 132, 252, .13) 0%, rgba(168, 85, 247, .04) 42%, transparent 80%);--accent-primary: #c084fc;--accent-secondary: #e879f9;--accent-glow: rgba(192, 132, 252, .35);--card-bg: rgba(255, 255, 255, .03);--card-border: rgba(192, 132, 252, .14);--text-primary: #faf5ff;--text-secondary: #d8b4fe;--text-muted: #6b7280;--console-bg: rgba(18, 10, 30, .88)}*{box-sizing:border-box;margin:0;padding:0;user-select:none;-webkit-user-select:none}body{font-family:Plus Jakarta Sans,-apple-system,BlinkMacSystemFont,sans-serif;background-color:var(--bg-color);background-image:var(--bg-gradient);background-attachment:fixed;color:var(--text-primary);min-height:100vh;display:flex;align-items:center;justify-content:center;overflow-x:hidden;overflow-y:auto;transition:background-color 1.2s cubic-bezier(.16,1,.3,1),background-image 1.2s cubic-bezier(.16,1,.3,1)}#root{width:100%;min-height:100vh;display:flex;align-items:center;justify-content:center;position:relative}.celestial-backdrop{position:fixed;top:0;right:0;bottom:0;left:0;width:100vw;height:100vh;z-index:0;pointer-events:none;transform:scale(1.01);transition:opacity .9s cubic-bezier(.16,1,.3,1),filter .9s cubic-bezier(.16,1,.3,1),background .9s ease}.celestial-backdrop,.celestial-backdrop.backdrop-horizon{background-image:radial-gradient(ellipse 640px 760px at 50% 48%,#05070e9e,#05070e73 45%,#05070e1f 80%,#03050acc),linear-gradient(180deg,#03050ab8,#03050a2e 28%,#03050a38 65%,#03050aeb),url(./sanctuary_bg.jpg);background-size:cover;background-position:center 36%;background-repeat:no-repeat;filter:brightness(.96) contrast(1.04)}[data-theme=sunrise] .celestial-backdrop.backdrop-horizon,[data-theme=sunrise] .celestial-backdrop{background-image:radial-gradient(ellipse 640px 760px at 50% 48%,#0d08059e,#0d080573 45%,#0d08051f 80%,#0d0805d1),linear-gradient(180deg,#0d0805b8,#0d08052e 28%,#0d080538 65%,#0d0805eb),url(./alpine_starlight.jpg);background-position:center 36%;filter:brightness(.98) contrast(1.05)}[data-theme=forest] .celestial-backdrop.backdrop-horizon,[data-theme=forest] .celestial-backdrop{filter:hue-rotate(65deg) saturate(.85) brightness(.94)}[data-theme=lavender] .celestial-backdrop.backdrop-horizon,[data-theme=lavender] .celestial-backdrop{filter:hue-rotate(215deg) saturate(1.05) brightness(.94)}.celestial-backdrop.backdrop-void{background-image:none!important;background:radial-gradient(circle at 50% 42%,#0e162a80,#050810f5 65%,#03050a)!important;filter:none!important}.celestial-backdrop.backdrop-nebula{background-image:none!important;background:radial-gradient(ellipse 800px 600px at 25% 25%,rgba(56,189,248,.14) 0%,transparent 60%),radial-gradient(ellipse 700px 500px at 75% 65%,rgba(168,85,247,.14) 0%,transparent 60%),radial-gradient(ellipse 600px 600px at 50% 85%,rgba(245,158,11,.1) 0%,transparent 60%),#04060e!important;filter:none!important}.ambient-canvas{position:fixed;top:0;left:0;width:100vw;height:100vh;z-index:1;pointer-events:none}.font-serif-hero{font-family:Cormorant Garamond,Georgia,serif}.font-sans-body{font-family:Plus Jakarta Sans,-apple-system,BlinkMacSystemFont,sans-serif}.font-mono-data{font-family:JetBrains Mono,monospace}.monolith-wrapper{position:relative;z-index:10;width:100%;max-width:480px;min-height:92vh;padding:24px 18px;display:flex;flex-direction:column;align-items:center;justify-content:space-between;text-align:center;transition:all .8s cubic-bezier(.16,1,.3,1)}.monolith-brand{display:flex;align-items:center;gap:10px;font-size:13px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--text-secondary);transition:opacity .8s cubic-bezier(.16,1,.3,1)}.freq-tag{font-size:10px;font-family:JetBrains Mono,monospace;padding:2px 8px;border-radius:9999px;background:#ffffff0d;border:1px solid var(--card-border);color:var(--accent-primary)}.breathing-nexus{position:relative;width:154px;height:154px;display:flex;align-items:center;justify-content:center;cursor:pointer;margin:10px 0 14px;flex-shrink:0;transition:transform .8s cubic-bezier(.16,1,.3,1)}.nexus-warm-aura{position:absolute;top:-22px;right:-22px;bottom:-22px;left:-22px;border-radius:50%;background:radial-gradient(circle,rgba(251,146,60,.42) 0%,rgba(245,158,11,.22) 40%,rgba(234,88,12,.08) 60%,transparent 75%);filter:blur(20px);opacity:.75;transition:all 4s cubic-bezier(.4,0,.2,1)}.nexus-outer-halo{position:absolute;top:-10px;right:-10px;bottom:-10px;left:-10px;border-radius:50%;border:2px solid rgba(125,211,252,.9);box-shadow:0 0 24px #38bdf8bf,0 0 10px #ffffffe6,inset 0 0 14px #38bdf866;opacity:.85;transition:all 4s cubic-bezier(.4,0,.2,1)}.nexus-glow-disc{position:absolute;top:0;right:0;bottom:0;left:0;border-radius:50%;background:radial-gradient(circle,rgba(56,189,248,.35) 0%,rgba(56,189,248,.1) 48%,transparent 72%);filter:blur(12px);opacity:.7;transition:all 4s cubic-bezier(.4,0,.2,1)}.nexus-core-sphere{position:relative;z-index:2;width:96px;height:96px;border-radius:50%;background:radial-gradient(circle at 50% 28%,#ffffff2e,#0f172aa6 60%,#070a12e6);border:1.5px solid rgba(255,255,255,.32);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);box-shadow:0 14px 35px #000000bf,inset 0 1px #ffffff80,inset 0 -4px 12px #0006;display:flex;flex-direction:column;align-items:center;justify-content:center;transition:all .3s ease}.breathing-nexus:hover .nexus-core-sphere{border-color:#7dd3fccc;transform:scale(1.04)}.breath-inhale .nexus-warm-aura{transform:scale(1.26);opacity:.95;filter:blur(26px)}.breath-inhale .nexus-outer-halo{transform:scale(1.2);opacity:1;border-color:#fff;box-shadow:0 0 38px #38bdf8f2,0 0 16px #fff,inset 0 0 20px #7dd3fc99}.breath-inhale .nexus-glow-disc{transform:scale(1.25);opacity:.95}.breath-inhale .nexus-core-sphere{transform:scale(1.08);border-color:#fff9;box-shadow:0 0 35px #38bdf880,inset 0 1px #fffc}.breath-hold .nexus-warm-aura{transform:scale(1.22);opacity:.85}.breath-hold .nexus-outer-halo{transform:scale(1.2);opacity:.9}.breath-exhale .nexus-warm-aura{transform:scale(.92);opacity:.45;filter:blur(16px)}.breath-exhale .nexus-outer-halo{transform:scale(.96);opacity:.35;box-shadow:0 0 12px #38bdf866}.breath-exhale .nexus-glow-disc{transform:scale(.92);opacity:.35}.breath-exhale .nexus-core-sphere{transform:scale(.96);border-color:#fff3}.nexus-wavy-ripples{position:absolute;top:96%;left:50%;transform:translate(-50%);width:160px;display:flex;flex-direction:column;align-items:center;gap:5px;pointer-events:none;opacity:.85}.water-ripple{height:2.5px;border-radius:9999px;background:radial-gradient(ellipse at center,rgba(251,191,36,.95) 0%,rgba(56,189,248,.75) 45%,rgba(255,255,255,.6) 70%,transparent 90%);box-shadow:0 0 14px #f59e0bbf,0 0 8px #38bdf899;animation:waterRippleWave 4s infinite ease-in-out}.ripple-1{width:120px;animation-delay:0s;opacity:.95}.ripple-2{width:92px;animation-delay:.6s;opacity:.75}.ripple-3{width:68px;animation-delay:1.2s;opacity:.55}.ripple-4{width:44px;animation-delay:1.8s;opacity:.35}@keyframes waterRippleWave{0%,to{transform:scaleX(.92) translateY(0);opacity:.55}50%{transform:scaleX(1.2) translateY(2px);opacity:1}}.mac-dots{display:inline-flex;align-items:center;gap:6px}.mac-dot{width:9px;height:9px;border-radius:50%;display:inline-block}.mac-dot.red{background:#ff5f56;border:1px solid rgba(0,0,0,.2)}.mac-dot.yellow{background:#ffbd2e;border:1px solid rgba(0,0,0,.2)}.mac-dot.green{background:#27c93f;border:1px solid rgba(0,0,0,.2)}.landing-orb{position:relative;width:140px;height:140px;margin:10px 0;display:flex;align-items:center;justify-content:center;cursor:pointer}.landing-orb-warm-aura{position:absolute;top:-20px;right:-20px;bottom:-20px;left:-20px;border-radius:5